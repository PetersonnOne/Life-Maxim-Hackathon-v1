# Frontend: public Convex deployment URL; populated by the Convex CLI locally.
NEXT_PUBLIC_CONVEX_URL=
# Backend secrets belong in Convex environment settings, never NEXT_PUBLIC_*.
# AUTH_PRIVATE_KEY and AUTH_JWKS: generated by the Convex Auth V2 setup command.
# FIRECRAWL_API_KEY
# AGENTMAIL_API_KEY
# Incoming mail uses scheduled API polling; no webhook secret is required.
# OPENROUTER_API_KEY
# Models are server-selected in convex/modelRouting.ts; no Convex AI Gateway.
